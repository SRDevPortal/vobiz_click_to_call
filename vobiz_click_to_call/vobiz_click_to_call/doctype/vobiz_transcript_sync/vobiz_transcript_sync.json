{
  "doctype": "DocType",
  "name": "Vobiz Transcript Sync",
  "module": "Vobiz Click To Call",
  "autoname": "hash",
  "engine": "InnoDB",
  "track_changes": 0,
  "field_order": [
    "from_date",
    "to_date",
    "max_call_logs",
    "batch_size",
    "status",
    "account_id",
    "requested_by",
    "scan_until",
    "cursor_time",
    "cursor_name",
    "processed",
    "updated",
    "skipped",
    "unavailable",
    "failed",
    "retry_count",
    "next_attempt",
    "last_message"
  ],
  "fields": [
    {
      "fieldname": "from_date",
      "label": "From date",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "to_date",
      "label": "To date",
      "fieldtype": "Date",
      "reqd": 1,
      "description": "Call log creation date in the site's timezone. Maximum 31 days per run."
    },
    {
      "fieldname": "max_call_logs",
      "label": "Maximum call logs",
      "fieldtype": "Int",
      "default": "1000",
      "reqd": 1,
      "description": "Total call logs to check in this run (1\u2013100,000), including skipped or unavailable logs. For example 1,000 or 10,000."
    },
    {
      "fieldname": "batch_size",
      "label": "Calls per batch",
      "fieldtype": "Int",
      "default": "25",
      "reqd": 1,
      "description": "1\u201350 call logs checked per background batch."
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nQueued\nRunning\nPaused\nCompleted\nFailed",
      "default": "Draft",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "account_id",
      "label": "Vobiz account",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "requested_by",
      "label": "Started by",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "scan_until",
      "label": "Snapshot cutoff",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "cursor_time",
      "label": "Last checked time",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "cursor_name",
      "label": "Last checked call",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "processed",
      "label": "Calls checked",
      "fieldtype": "Int",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "updated",
      "label": "Transcripts recovered",
      "fieldtype": "Int",
      "default": "0",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "skipped",
      "label": "Already present / ineligible",
      "fieldtype": "Int",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "unavailable",
      "label": "Not available at provider",
      "fieldtype": "Int",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "failed",
      "label": "Failed lookups",
      "fieldtype": "Int",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "retry_count",
      "label": "Current retry attempt",
      "fieldtype": "Int",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "next_attempt",
      "label": "Next attempt after",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "last_message",
      "label": "Latest result",
      "fieldtype": "Small Text",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "create": 1,
      "read": 1,
      "write": 1,
      "report": 1
    }
  ],
  "sort_field": "creation",
  "sort_order": "DESC"
}
